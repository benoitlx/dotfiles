[Unit]
Description=Unlock the rbw (Bitwarden) vault at login
# The agent runs in its own unit: a oneshot kills its leftover children on exit
Requires=rbw-agent.service
After=rbw-agent.service graphical-session.target
PartOf=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=oneshot
# rbw always spawns rbw-agent through PATH, and systemd's PATH lacks ~/.cargo/bin
Environment=PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.cargo/bin/rbw unlock

[Install]
WantedBy=graphical-session.target
