let {
  $tray = {
    type = "tray"
  }
  $clock = {
    type = "clock"
    format = "%B %d %H:%M:%S"
    format_popup = ""
  }
  $battery = {
    type = "battery"
    format = "{percentage}%"
    disable_popup = true
    tooltip = "{{cat /sys/class/power_supply/BAT0/status}}"
  }
  $workspaces = {
    type = "workspaces"
    name_map.1 = "main"
  }
  $notifications = {
    type = "notifications"
    show_count = true
  }
  $sys_info = {
    type = "sys_info"
    
    interval.memory = 30
    interval.cpu = 1
    interval.disks = 300
    interval.temps = 3
    interval.network = 1

    format = [
      " {cpu_percent}%"
      " {memory_percent}%"
      " {temp_c:CPUTIN}°C"
      " {disk_used@/var}GB"
      "󰇚{net_down@enp3s0}󰕒{net_up@enp3s0}"
    ]

    on_click_left = "kitty btop"
  }

  $music = {
    type = "music"
    player_type = "mpris"
    truncate = "end"
  }

  $volume = {
    type = "volume"
    format = "{icon} {percentage}%"
    truncate = "end"
    max_volume = 100
    on_scroll_up = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+"
    on_scroll_down = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"
    smooth_scroll_speed = 0.08
  }

  $cava = {
    transition_type = "slide_end"
    transition_duration = 750
    name = "cava"
    type = "script"
    mode = "watch"
    cmd = "~/.config/ironbar/scripts/cava"

    show_if = "exit 0"
  }

  $network = {
    type = "network_manager"
  }
  $ble = {
    type = "bluetooth"
    popup.scrollable = false
    popup.header = "Toggle"
  }

  $left = [$volume $cava $music]
  $center = [$clock]
  $right = [$tray $sys_info $battery $network $ble $notifications]
}
in {
  position = "top"

  start = $left
  center = $center
  end = $right

  height = 20
  margin.top = 10

  popup_autohide = true

  icon_theme = "Adwaita"
}
