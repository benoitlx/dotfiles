#!/usr/bin/bash

# Pass the tailscale auth key to wishlist via bitwarden rust cli

gum spin --spinner points --title "Unlocking Vaultwarden" -- sh -c "rbw unlock"

raw_bw_oauth=$(gum spin --spinner points --title "getting ts id and secret" -- sh -c "rbw get tailscale_oauth --raw")
id=$(echo "$raw_bw_oauth" | jq -r '.data.username')
secret=$(echo "$raw_bw_oauth" | jq -r '.data.password')

wishlist --tailscale.net=taild069bb.ts.net --tailscale.client.id="$id" --tailscale.client.secret="$secret"
